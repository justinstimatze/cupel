#!/usr/bin/env bash
# Pre-push: heavier checks that mirror CI. Catches test failures before they
# land in the cloud (where they show up in the workflow run and slow the loop).
# Skips if no Go file is in the commits about to be pushed.
#
# Override:  SKIP_HOOKS=1 git push ...

set -euo pipefail

if [[ "${SKIP_HOOKS:-}" == "1" ]]; then
    echo "pre-push: SKIP_HOOKS=1 — skipping" >&2
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Read the refs being pushed from stdin; figure out which commits are new
# vs the remote, then check whether any of them touched a Go file. If none did,
# skip the test run — same logic CI uses to keep the loop fast.
needs_test=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "$local_sha" ]] && continue
    # 40 zeros = branch being deleted; nothing to test
    if [[ "$local_sha" =~ ^0+$ ]]; then
        continue
    fi
    if [[ "$remote_sha" =~ ^0+$ ]]; then
        # New branch — diff against the merge-base with HEAD's upstream
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    if git diff --name-only "$range" 2>/dev/null | grep -q '\.go$'; then
        needs_test=1
    fi
done

if [[ "$needs_test" -eq 0 ]]; then
    echo "pre-push: no Go changes — skipping tests" >&2
    exit 0
fi

echo "pre-push: go test ./cmd/cupel..." >&2
go test ./cmd/cupel
echo "pre-push: ✓ tests passed" >&2
