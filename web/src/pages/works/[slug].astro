---
import Layout from "@/layouts/Layout.astro";
import worksData from "@/data/works.json";
import type { Work } from "@/lib/types";

export async function getStaticPaths() {
  const works = worksData as Work[];
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

interface Props {
  work: Work;
}

const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");

const badgeClass = (backing: string): string => {
  if (backing === "slot-proven")
    return "ml-2 inline-block px-2 py-px font-sans text-[12px] font-medium rounded-[6px] border border-green-700/40 text-green-300/90 bg-green-900/20 align-[3px]";
  return "ml-2 inline-block px-2 py-px font-sans text-[12px] font-medium rounded-[6px] border border-border text-dim align-[3px]";
};

const description =
  work.bead?.slice(0, 200) ?? `${work.work} — read in the cupel catalog.`;
---

<Layout title={`${work.work} — cupel`} description={description}>
  <header class="mx-auto max-w-[760px] px-[22px] pt-[42px] pb-2">
    <a
      href={`${base}/`}
      class="font-sans text-primary text-[12.5px] inline-block mb-[14px] no-underline hover:underline"
      >&larr; all works</a
    >
    <h1
      class="m-0 font-sans text-[34px] font-semibold tracking-[-0.01em] leading-[1.1] text-foreground"
    >
      {work.work}
    </h1>
    <div class="font-sans text-[14px] text-dim mt-2 leading-[1.5]">
      <span class={badgeClass(work.backing).replace(/^ml-2 /, "mr-2 ")}>
        {work.backing}
      </span>
      {work.author}
      {work.translator && <span> &middot; trans. {work.translator}</span>}
      {work.year && <span> &middot; {work.year}</span>}
      {work.medium && <span> &middot; {work.medium}</span>}
    </div>
    {
      work.source && (
        <div class="font-sans text-[12.5px] text-dim mt-1">{work.source}</div>
      )
    }
    {
      work.author_note && (
        <div class="font-sans text-[13px] text-amber-200/90 bg-amber-900/20 border-l-[3px] border-amber-700/50 px-3 py-2 rounded-r-md mt-3">
          &#9888; {work.author_note}
        </div>
      )
    }
  </header>
  <main
    class="max-w-[760px] mx-auto px-[22px] py-2 pb-[60px] font-serif text-[16px] leading-[1.65] [&_h2]:font-sans [&_h2]:text-[20px] [&_h2]:font-semibold [&_h2]:mt-6 [&_h2]:mb-3 [&_h2]:text-primary [&_h2]:uppercase [&_h2]:tracking-[0.05em] [&_h2]:text-[14px] [&_h3]:font-sans [&_h3]:text-[16px] [&_h3]:font-semibold [&_h3]:mt-5 [&_h3]:mb-2 [&_h3]:text-ink-soft [&_p]:my-3 [&_b]:font-semibold [&_a]:text-primary [&_a]:underline-offset-[3px] hover:[&_a]:underline [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:my-1 [&_blockquote]:border-l-2 [&_blockquote]:border-border [&_blockquote]:pl-3 [&_blockquote]:text-ink-soft [&_blockquote]:my-3 [&_code]:font-mono [&_code]:text-[14px] [&_code]:bg-bg-soft [&_code]:px-1 [&_code]:rounded-[3px] [&_hr]:border-border [&_hr]:my-6 [&_table]:my-4 [&_table]:w-full [&_table]:font-sans [&_table]:text-[14px] [&_table]:border-collapse [&_th]:font-semibold [&_th]:text-left [&_th]:px-2 [&_th]:py-2 [&_th]:border-b [&_th]:border-border [&_th]:text-ink-soft [&_td]:px-2 [&_td]:py-2 [&_td]:border-b [&_td]:border-border/40 [&_td]:align-top"
    tabindex="-1"
    set:html={work.full_html}
  />
</Layout>
