---
import Layout from "@/layouts/Layout.astro";
import enginesData from "@/data/engines.json";
import type { EngineSpec } from "@/lib/types";

export async function getStaticPaths() {
  const engines = enginesData as EngineSpec[];
  return engines.map((spec) => ({
    params: { slug: spec.slug },
    props: { spec },
  }));
}

interface Props {
  spec: EngineSpec;
}

const { spec } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const description = spec.tagline ?? `${spec.name} — engine in the cupel catalog.`;
---

<Layout title={`${spec.name} — engine`} description={description}>
  <header class="mx-auto max-w-[760px] px-[22px] pt-[42px] pb-2">
    <div class="font-sans text-[12.5px] mb-[14px]">
      <a href={`${base}/`} class="text-primary no-underline hover:underline"
        >&larr; cupel</a
      >
      <span class="text-dim mx-1">&middot;</span>
      <a
        href={`${base}/engines/`}
        class="text-primary no-underline hover:underline">all engines</a
      >
    </div>
    <h1
      class="m-0 font-sans text-[34px] font-semibold tracking-[-0.01em] leading-[1.1] text-foreground"
    >
      {spec.name}
    </h1>
    {
      spec.tagline && (
        <p class="font-sans text-[14px] text-dim mt-2 leading-[1.5]">
          {spec.tagline}
        </p>
      )
    }
  </header>
  <main
    class="max-w-[760px] mx-auto px-[22px] py-2 pb-[60px] font-serif text-[16px] leading-[1.65] [&_h2]:font-sans [&_h2]:text-[20px] [&_h2]:font-semibold [&_h2]:mt-6 [&_h2]:mb-2 [&_h3]:font-sans [&_h3]:text-[16px] [&_h3]:font-semibold [&_h3]:mt-5 [&_h3]:mb-2 [&_h3]:text-ink-soft [&_p]:my-3 [&_b]:font-semibold [&_a]:text-primary [&_a]:underline-offset-[3px] hover:[&_a]:underline [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:my-1 [&_table]:my-4 [&_table]:w-full [&_table]:font-sans [&_table]:text-[14px] [&_table]:border-collapse [&_th]:font-semibold [&_th]:text-left [&_th]:px-2 [&_th]:py-2 [&_th]:border-b [&_th]:border-border [&_th]:text-ink-soft [&_td]:px-2 [&_td]:py-2 [&_td]:border-b [&_td]:border-border/40 [&_td]:align-top [&_blockquote]:border-l-2 [&_blockquote]:border-border [&_blockquote]:pl-3 [&_blockquote]:text-ink-soft [&_blockquote]:my-3"
    tabindex="-1"
  >
    <Fragment set:html={spec.body_html} />
    {
      spec.works && spec.works.length > 0 && (
        <>
          <h2>Works that run this</h2>
          <ul>
            {spec.works.map((w) =>
              w.href ? (
                <li>
                  <a href={w.href}>{w.work}</a>
                </li>
              ) : (
                <li>{w.work}</li>
              ),
            )}
          </ul>
        </>
      )
    }
  </main>
</Layout>
