---
import Layout from "@/layouts/Layout.astro";
import enginesData from "@/data/engines.json";
import type { EngineSpec } from "@/lib/types";

const engines = enginesData as EngineSpec[];
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
---

<Layout
  title="cupel — the engines"
  description="Each engine names a wish a story pays out. Every engine has a counterfeit — the same machine sold as a recruitment pitch."
>
  <header class="mx-auto max-w-[760px] px-[22px] pt-[42px] pb-2">
    <a
      href={`${base}/`}
      class="font-sans text-primary text-[12.5px] inline-block mb-[14px] no-underline hover:underline"
      >&larr; cupel</a
    >
    <h1
      class="m-0 font-sans text-[34px] font-semibold tracking-[-0.01em] leading-[1.1] text-foreground"
    >
      The engines
    </h1>
    <p class="font-sans text-[14px] text-dim mt-2 leading-[1.5]">
      Each engine names a wish a story pays out: the reader is stuck,
      something releases them, and the release is the payoff. Every engine has
      a counterfeit &mdash; the same machine sold as a recruitment pitch, the
      payoff identity minus the costly work that earns it.
    </p>
  </header>
  <main class="max-w-[760px] mx-auto px-[22px] py-2 pb-[60px]" tabindex="-1">
    {
      engines.map((spec) => (
        <a
          href={`${base}/engines/${spec.slug}/`}
          class="block bg-card border border-border rounded-[10px] p-[14px_18px] mb-[10px] no-underline text-foreground hover:border-primary transition-colors"
        >
          <b class="text-primary font-sans text-[15px] font-semibold tracking-[-0.005em]">
            {spec.name}
          </b>
          {spec.tagline && (
            <span class="block text-dim font-sans text-[13px] mt-[3px] leading-[1.45]">
              {spec.tagline}
            </span>
          )}
        </a>
      ))
    }
  </main>
</Layout>
