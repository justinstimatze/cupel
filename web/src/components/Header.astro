---
const enginesHref = `${import.meta.env.BASE_URL}/engines/`.replace(/\/+/g, "/");
const clustersHref = `${import.meta.env.BASE_URL}/clusters/`.replace(/\/+/g, "/");
const glossaryHref = `${import.meta.env.BASE_URL}/glossary/`.replace(/\/+/g, "/");
---

<header class="mx-auto max-w-[760px] px-[22px] pt-[42px] pb-2">
  <h1
    class="font-sans text-[34px] font-semibold tracking-[-0.01em] leading-[1.1] text-foreground"
  >
    cupel
  </h1>
  <p class="font-sans text-[14px] text-dim mt-2 leading-[1.5]">
    A catalog of the wish-fulfillment engines stories run on — and of the
    dark-twin grifts (cults, conspiracy theories, pickup-artist scripts) that
    wear each engine&rsquo;s face.
  </p>
  <div class="font-sans mt-3 text-[13.5px] flex gap-[18px]">
    <a
      href={enginesHref}
      class="text-primary no-underline hover:underline">the engines &rarr;</a
    >
    <a
      href={clustersHref}
      class="text-primary no-underline hover:underline">the clusters &rarr;</a
    >
    <a
      href={glossaryHref}
      class="text-primary no-underline hover:underline">the glossary &rarr;</a
    >
  </div>
</header>
