---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const defaultDescription =
  "A catalog of the wish-fulfillment engines stories run on — and of the dark-twin grifts (cults, conspiracy theories, pickup-artist scripts) that wear each engine's face.";
const resolvedDescription = description ?? defaultDescription;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const resolvedOgImage = new URL(
  `${import.meta.env.BASE_URL}/${ogImage ?? "og-card.png"}`.replace(/\/+/g, "/"),
  Astro.site,
).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="cupel" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />
  </head>
  <body>
    <slot />
    <footer
      class="font-sans text-dim text-[11.5px] max-w-[760px] mx-auto px-[22px] py-6 border-t border-border"
    >
      cupel&rsquo;s own code and prose are released under the MIT License.
      Quoted excerpts from in-copyright works are reproduced only as short
      passages, under fair use for criticism and commentary, and remain the
      property of their respective rights-holders.
    </footer>
  </body>
</html>
