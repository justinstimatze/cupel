# cupel v2 lens — config template. Copy to `.env` and fill in the key.
#   cp .env.example .env   &&   $EDITOR .env
#
# `.env` is gitignored (never committed); this `.env.example` is the tracked
# template (no secret). The hook loads the key from the real environment
# first (ANTHROPIC_API_KEY, as it is in a live Claude Code session); the
# .env is the fallback for local testing from this repo.
#
# THE LENS IS OPTIONAL AND FAIL-SAFE. If the key is absent the hook skips the
# API lens entirely and falls back to the local gate alone — it never blocks a
# turn, never errors out (no key -> no lens).

# --- the only required field for the API lens ---
# The hook reads the key from the live process env FIRST (as a Claude Code
# session has it). If it isn't in the env, set CUPEL_ENV_FILE to point the hook
# at THIS file (the hook runs globally, so it can't find the repo .env by a
# relative path); otherwise it looks in ~/.claude/cupel/.env.
ANTHROPIC_API_KEY=

# --- lens (Anthropic API; runs only when the local gate trips) ---
# Haiku is the per-fire lens model (cheap/fast).
CUPEL_LENS_MODEL=claude-haiku-4-5-20251001
# Kill switch: set to 1 to force gate-only (no API calls) without removing the key.
CUPEL_LENS_DISABLED=

# --- local gate (ollama embedding similarity; runs on every prompt) ---
CUPEL_OLLAMA_URL=http://localhost:11434
# Embedder. nomic-embed-text won the re-run separation probe: clean class
# separation (POS floor 0.589 > NEG ceiling 0.556) at ~60ms warm — fast enough
# to pay on every prompt. (qwen2:1.5b separated wider, +0.138, but cost ~0.9s
# per prompt; all-minilm was 20ms but OVERLAPPED, -0.072.) Pull it once:
#   ollama pull nomic-embed-text
CUPEL_EMBED_MODEL=nomic-embed-text
# Cosine gate threshold, tuned RECALL-FIRST (a false trip only costs one lens
# call, which then rejects it). Probe for nomic: POS floor 0.589, NEG ceiling
# 0.556 -> 0.57 sits in the gap. Re-tune from `cupel doctor`'s gate_sim once
# real fires accumulate. (A different CUPEL_EMBED_MODEL needs its own threshold.)
CUPEL_GATE_THRESHOLD=0.57

# --- shared HTTP timeout (gate + lens). A hook must never hang a turn; on
# timeout the gate falls back to lexical and the lens is skipped. ---
CUPEL_HTTP_TIMEOUT_MS=8000

# --- v2.1 critic (`cupel critic` — DEV-TIME ONLY; the hook never runs it) ---
# A stacked loop: diagnose each engine prototype's separation on the held-out
# corpus, propose tighter prototypes for the weakest (Haiku), and accept only
# edits a deterministic ablation proves widen separation. Propose-only — it never
# mutates engines.json. These are tuning knobs, not runtime hook config.
# Flag engines whose separation margin (own recall floor − confusion ceiling) is
# below this:
CUPEL_CRITIC_MARGIN=0.05
# Max engines to propose for per run (bounds API spend; proposals are cached):
CUPEL_CRITIC_MAX=3
# Proposal model (defaults to the lens model):
CUPEL_CRITIC_MODEL=claude-haiku-4-5-20251001
# Override the held-out corpus with a JSON array of {"engine","text"} (engine:""
# = benign negative). The honest-grounding path (v2.2): point this at the real
# recruitment-ancestor corpus instead of the built-in synthetic seed set.
# Generate that corpus from the local ancestor texts with:
#   cupel build-corpus --dir /tmp --out /tmp/cupel-critic-corpus.json
# If this path is missing/unparseable the critic SILENTLY falls back to the
# built-in synthetic seed (the margin table's "corpus: N POS / M NEG" line tells
# you which is live). A large corpus may need a raised CUPEL_HTTP_TIMEOUT_MS (the
# critic embeds it in one batch).
CUPEL_CRITIC_CORPUS=

# --- OpenSubtitles API + consumer (for subtitle-verification of TV/film cards) ---
# Sign up at https://www.opensubtitles.com/en/users/sign_up then create a consumer at
# https://www.opensubtitles.com/en/consumers — free tier ~5 downloads/day, ~100 searches/day.
# All four vars are OPTIONAL — workflows that need subtitles skip gracefully if unset.
OPENSUBTITLES_API_KEY=
# OPENSUBTITLES_USER_AGENT *must* match the consumer name you registered + version
# (e.g. "cupel v0.1.0"). Kong gateway rejects unregistered UAs with 403; there is
# no default.
OPENSUBTITLES_USER_AGENT=
# Only needed for download/fetch (not for search). Use the same username/password
# you logged in with at opensubtitles.com.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
